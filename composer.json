{
  "name": "comphp/session-comphp-database",
  "type": "library",
  "description": "Session Driver for CommonPHP that reads/stores session data in a CommonPHP Database connection",
  "license": "MIT",
  "version": "0.3",
  "autoload": {
    "psr-4": {
      "CommonPHP\\Drivers\\Session\\CommonPHPDatabase\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CommonPHP\\Drivers\\Session\\CommonPHPDatabase\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.5",
    "comphp/session": "^0.3",
    "comphp/database": "^0.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.1",
    "friendsofphp/php-cs-fixer": "^3.95"
  }
}